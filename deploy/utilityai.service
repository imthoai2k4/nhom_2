[Unit]
Description=UtilityAI - Quan ly hoa don dien nuoc
After=network.target

[Service]
Type=simple
User=utilityai
Group=utilityai
WorkingDirectory=/opt/utilityai
EnvironmentFile=/opt/utilityai/.env
ExecStart=/opt/utilityai/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
TimeoutStopSec=30

# JWT/secret không cần vì demo dùng header auth; production nên bổ sung.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/utilityai

[Install]
WantedBy=multi-user.target
