# API chuẩn OpenAI cho Qwen3.8-27B (Intern-AI Discovery)
# Điền API key thật vào AI_API_KEY. Không commit file .env.
AI_API_KEY=
AI_BASE_URL=https://discovery-api.intern-ai.org.cn/v1
AI_MODEL=qwen3.8-27b
AI_TIMEOUT=30
AI_MAX_TOKENS=4096
AI_CACHE_TTL=300

# CORS: chỉ domain frontend được gọi API
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Seed dữ liệu demo khi DB rỗng (đặt 0 trên production)
SEED_DEMO_DATA=1

# Rate limit request/phút
AI_RATE_LIMIT=30
CHAT_RATE_LIMIT=60

# Tên file database SQLite
DATABASE_URL=sqlite:///./utility_mgmt.db

# Tài khoản admin mặc định (demo)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
