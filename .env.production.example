# Biến môi trường production — sao chép thành .env trên server
# KHÔNG commit file .env thật.

AI_API_KEY=
AI_BASE_URL=https://discovery-api.intern-ai.org.cn/v1
AI_MODEL=qwen3.8-27b
AI_TIMEOUT=30
AI_MAX_TOKENS=4096

# SQLite đường dẫn tuyệt đối trên Linux (4 dấu /)
DATABASE_URL=sqlite:////opt/utilityai/utility_mgmt.db

ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi_mat_khau_manh

# Chỉ domain frontend được gọi API
CORS_ORIGINS=https://your-domain.com

# Production: bật HSTS sau khi đã có HTTPS
ENABLE_HSTS=1

# Không seed dữ liệu demo trên production
SEED_DEMO_DATA=0

# Giới hạn request/phút
AI_RATE_LIMIT=10
CHAT_RATE_LIMIT=30
